# Energo backend configuration (Linux deployment)
PORT=4000
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-in-production
# STS master secret used to derive per-meter vending keys. 32+ random bytes recommended.
STS_MASTER_KEY=

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=12345
DB_NAME=ener-go

# Copy this file to .env on the server: cp .env.linux .env
